# Build output
/dev
/dist/
*.test

# Worktrees created by agent harnesses. Keep this: without it, a worktree's
# contents show as untracked files in the main checkout.
.claude/worktrees/

# Local machine state
.DS_Store

# SpecStory's aggregate is regenerated on every render. Session transcripts are
# durable review history; this derived counter file is not.
.specstory/statistics.json

# Plan files written by the agent harness for this session, not project docs.
# .claude/plans/


# mkdocs build output (regenerated every build)
/site/

# Python cache generated by MkDocs hooks
/scripts/__pycache__/
